{
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://calcfinanceira.com.br/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.calcfinanceira.com.br"
        }
      ],
      "permanent": true
    },
    {
      "source": "/(.*)",
      "destination": "https://calcfinanceira.com.br/:path*",
      "has": [
        {
          "type": "host",
          "value": "calculadoras-financeiras-two.vercel.app"
        }
      ],
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
